<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".mvvm.activity.SearchActivity">

    <data>
        <variable
            name="viewModel"
            type="com.systemcontrol.corpsele.systemcontrol.mvvm.viewmodel.SearchViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_input"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="请输入关键词"
            android:text="@={viewModel.inputText}" />

        <!-- 搜索按钮 -->
        <EditText
            android:id="@+id/et_apikey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="请输入apikey"
            android:text="@={viewModel.apiKey}"
            tools:layout_editor_absoluteX="-1dp" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> viewModel.performSearch()}"
            android:text="发送问题 (Chat)"
            app:layout_constraintTop_toBottomOf="@id/et_apikey" />
        <!-- 结果显示区域 1：使用自定义 Adapter -->
        <!-- 注意：这里防止空指针，resultData 可能为空时表达式处理 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="300dp">
        <TextView
            android:id="@+id/tv_strReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="#F0F0F0"
            android:padding="10dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:focusableInTouchMode="true"
            android:focusable="true"
            android:clickable="true"
            app:layout_constraintTop_toBottomOf="@id/btn_search"
            app:strReply="@{viewModel.searchResults != null ? viewModel.searchResults.strReply : `等待ai回答`}" />
        </ScrollView>
        <!-- 结果显示区域 2：普通绑定 -->
<!--        <TextView-->
<!--            android:id="@+id/tv_keyWords"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="16dp"-->
<!--            android:background="#F0F0F0"-->
<!--            android:padding="10dp"-->
<!--            android:text="@{viewModel.searchResults != null ? viewModel.searchResults.keyWords : null}"-->
<!--            android:textSize="16sp"-->
<!--            app:layout_constraintTop_toBottomOf="@id/tv_strReply" />-->

        <!-- 目标图片 -->
        <ImageView
            android:id="@+id/iv_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Loading 动画 (居中遮罩) -->
        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />
    </LinearLayout>

</layout>
